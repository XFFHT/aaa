+    public async Task<ApiResponse<IReadOnlyList<RagFlowChunkDto>>> GetResourceChunksAsync(long resourceId)
+    {
+        var metadata = await db.ResourceAiMetadata.FirstOrDefaultAsync(x => x.ResourceId == resourceId);
+        if (metadata is null || string.IsNullOrWhiteSpace(metadata.RagFlowDatasetId) || string.IsNullOrWhiteSpace(metadata.RagFlowDocumentId))
+        {
+            return ApiResponse<IReadOnlyList<RagFlowChunkDto>>.Fail("Resource has not been ingested to RAGFlow.");
+        }
+
+        var chunks = await ListChunksAsync(metadata.RagFlowDatasetId, metadata.RagFlowDocumentId);
+        metadata.RagFlowChunkCount = chunks.Count;
+        await db.SaveChangesAsync();
+        return ApiResponse<IReadOnlyList<RagFlowChunkDto>>.Ok(chunks);
+    }

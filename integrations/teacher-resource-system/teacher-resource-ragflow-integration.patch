diff --git a/backend/TeacherResource.Api/Services/RagFlowService.cs b/backend/TeacherResource.Api/Services/RagFlowService.cs
new file mode 100644
index 0000000..d9d214e
--- /dev/null
+++ b/backend/TeacherResource.Api/Services/RagFlowService.cs
@@ -0,0 +1,906 @@
+using System.Globalization;
+using System.Net.Http.Headers;
+using System.Text;
+using System.Text.Json;
+using System.Text.RegularExpressions;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.Extensions.Options;
+using TeacherResource.Api.Common;
+using TeacherResource.Api.Data;
+using TeacherResource.Api.DTOs.RagFlow;
+using TeacherResource.Api.DTOs.Resources;
+using TeacherResource.Api.Models;
+using TeacherResource.Api.Options;
+
+namespace TeacherResource.Api.Services;
+
+public class RagFlowService(
+    HttpClient httpClient,
+    IOptions<RagFlowOptions> options,
+    AppDbContext db,
+    IWebHostEnvironment environment)
+{
+    private static readonly Regex InvalidPathChars = new(@"[<>:""/\\|?*\x00-\x1f]", RegexOptions.Compiled);
+    private readonly RagFlowOptions ragFlowOptions = options.Value;
+
+    public async Task<ApiResponse<RagFlowStatusDto>> GetStatusAsync()
+    {
+        try
+        {
+            var health = await SendAsync(HttpMethod.Get, "/api/v1/system/healthz", authorize: false);
+            var datasets = await ListDatasetsInternalAsync(null, 20);
+            return ApiResponse<RagFlowStatusDto>.Ok(new RagFlowStatusDto
+            {
+                BaseUrl = BaseUrl,
+                Online = true,
+                Message = health.RootElement.ToString(),
+                Datasets = datasets
+            });
+        }
+        catch (Exception ex)
+        {
+            return ApiResponse<RagFlowStatusDto>.Ok(new RagFlowStatusDto
+            {
+                BaseUrl = BaseUrl,
+                Online = false,
+                Message = ex.Message,
+                Datasets = []
+            });
+        }
+    }
+
+    public async Task<ApiResponse<IReadOnlyList<RagFlowDatasetDto>>> ListDatasetsAsync(string? name, int pageSize)
+    {
+        return ApiResponse<IReadOnlyList<RagFlowDatasetDto>>.Ok(await ListDatasetsInternalAsync(name, pageSize));
+    }
+
+    public async Task<ApiResponse<RagFlowDatasetDto>> CreateDatasetAsync(RagFlowCreateDatasetRequest request)
+    {
+        if (string.IsNullOrWhiteSpace(request.Name))
+        {
+            return ApiResponse<RagFlowDatasetDto>.Fail("Dataset name is required.");
+        }
+
+        var dataset = await EnsureDatasetAsync(
+            request.Name,
+            request.Description,
+            request.Permission,
+            request.ChunkMethod);
+
+        return ApiResponse<RagFlowDatasetDto>.Ok(dataset);
+    }
+
+    public async Task<ApiResponse<RagFlowIngestResultDto>> IngestResourceFileAsync(
+        long resourceId,
+        long fileId,
+        RagFlowIngestResourceFileRequest request)
+    {
+        var resource = await BuildResourceQuery()
+            .FirstOrDefaultAsync(x => x.Id == resourceId && !x.IsDeleted);
+        if (resource is null)
+        {
+            return ApiResponse<RagFlowIngestResultDto>.Fail("Resource not found.");
+        }
+
+        var file = resource.Files.FirstOrDefault(x => x.Id == fileId && !x.IsDeleted);
+        if (file is null)
+        {
+            return ApiResponse<RagFlowIngestResultDto>.Fail("Resource file not found.");
+        }
+
+        var operatorId = request.OperatorId.GetValueOrDefault(resource.UploaderId);
+        var operatorExists = await db.Users.AnyAsync(x =>
+            !x.IsDeleted && x.OrganizationId == resource.OrganizationId && x.Id == operatorId);
+        if (!operatorExists)
+        {
+            return ApiResponse<RagFlowIngestResultDto>.Fail("Operator not found in this organization.");
+        }
+
+        try
+        {
+            var result = await IngestFileCoreAsync(resource, file, request.DatasetId, request.DatasetName, request.Parse);
+            AddOperationLog(
+                resource.OrganizationId,
+                resource.Id,
+                operatorId,
+                "IngestToRagFlow",
+                $"Ingested file {file.FileName} to RAGFlow dataset {result.DatasetName}.");
+            await db.SaveChangesAsync();
+            return ApiResponse<RagFlowIngestResultDto>.Ok(result);
+        }
+        catch (Exception ex)
+        {
+            EnsureAiMetadata(resource);
+            resource.AiMetadata!.ParseStatus = "解析失败";
+            resource.AiMetadata.CallableStatus = "不可调用";
+            resource.AiMetadata.RagFlowError = ex.Message;
+            AddOperationLog(resource.OrganizationId, resource.Id, operatorId, "IngestToRagFlowFailed", ex.Message);
+            await db.SaveChangesAsync();
+            return ApiResponse<RagFlowIngestResultDto>.Fail(ex.Message);
+        }
+    }
+
+    public async Task<ApiResponse<RagFlowContextPackIngestResultDto>> IngestContextPackAsync(
+        long contextPackId,
+        RagFlowIngestContextPackRequest request)
+    {
+        var pack = await db.ContextPacks
+            .Include(x => x.ContextPackResources)
+                .ThenInclude(x => x.Resource)
+                    .ThenInclude(x => x!.Files)
+            .Include(x => x.ContextPackResources)
+                .ThenInclude(x => x.Resource)
+                    .ThenInclude(x => x!.AiMetadata)
+            .Include(x => x.ContextPackResources)
+                .ThenInclude(x => x.Resource)
+                    .ThenInclude(x => x!.Subject)
+            .Include(x => x.ContextPackResources)
+                .ThenInclude(x => x.Resource)
+                    .ThenInclude(x => x!.Grade)
+            .FirstOrDefaultAsync(x => x.Id == contextPackId && !x.IsDeleted);
+        if (pack is null)
+        {
+            return ApiResponse<RagFlowContextPackIngestResultDto>.Fail("Context pack not found.");
+        }
+
+        var operatorId = request.OperatorId.GetValueOrDefault(pack.CreatorId);
+        var operatorExists = await db.Users.AnyAsync(x =>
+            !x.IsDeleted && x.OrganizationId == pack.OrganizationId && x.Id == operatorId);
+        if (!operatorExists)
+        {
+            return ApiResponse<RagFlowContextPackIngestResultDto>.Fail("Operator not found in this organization.");
+        }
+
+        var datasetName = request.DatasetName;
+        if (string.IsNullOrWhiteSpace(request.DatasetId) && string.IsNullOrWhiteSpace(datasetName))
+        {
+            datasetName = pack.Name;
+        }
+
+        var results = new List<RagFlowIngestResultDto>();
+        var datasetId = request.DatasetId;
+        var resolvedDatasetName = datasetName ?? string.Empty;
+
+        try
+        {
+            foreach (var relation in pack.ContextPackResources.OrderBy(x => x.SortOrder))
+            {
+                var resource = relation.Resource;
+                if (resource is null || resource.IsDeleted)
+                {
+                    continue;
+                }
+
+                var file = resource.Files
+                    .Where(x => !x.IsDeleted)
+                    .OrderByDescending(x => x.UploadedAt)
+                    .FirstOrDefault();
+                if (file is null)
+                {
+                    continue;
+                }
+
+                var result = await IngestFileCoreAsync(resource, file, datasetId, datasetName, request.Parse);
+                datasetId = result.DatasetId;
+                resolvedDatasetName = result.DatasetName;
+                results.Add(result);
+            }
+
+            pack.CallableStatus = await RecalculatePackCallableStatusAsync(pack.Id);
+            AddOperationLog(
+                pack.OrganizationId,
+                null,
+                operatorId,
+                "IngestContextPackToRagFlow",
+                $"Ingested context pack {pack.Name} to RAGFlow dataset {resolvedDatasetName}.");
+            await db.SaveChangesAsync();
+
+            return ApiResponse<RagFlowContextPackIngestResultDto>.Ok(new RagFlowContextPackIngestResultDto
+            {
+                ContextPackId = pack.Id,
+                DatasetId = datasetId ?? string.Empty,
+                DatasetName = resolvedDatasetName,
+                Resources = results
+            });
+        }
+        catch (Exception ex)
+        {
+            AddOperationLog(pack.OrganizationId, null, operatorId, "IngestContextPackToRagFlowFailed", ex.Message);
+            await db.SaveChangesAsync();
+            return ApiResponse<RagFlowContextPackIngestResultDto>.Fail(ex.Message);
+        }
+    }

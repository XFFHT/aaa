+    private async Task<IReadOnlyList<RagFlowDocumentDto>> UploadDocumentAsync(
+        string datasetId,
+        string fullPath,
+        string fileName,
+        string mimeType)
+    {
+        await using var stream = File.OpenRead(fullPath);
+        using var fileContent = new StreamContent(stream);
+        fileContent.Headers.ContentType = new MediaTypeHeaderValue(
+            string.IsNullOrWhiteSpace(mimeType) ? "application/octet-stream" : mimeType);
+
+        using var form = new MultipartFormDataContent();
+        form.Add(fileContent, "file", fileName);
+
+        var data = await SendAsync(HttpMethod.Post, $"/api/v1/datasets/{datasetId}/documents", form, timeoutSeconds: 600);
+        var payload = GetData(data.RootElement);
+        if (payload.ValueKind != JsonValueKind.Array)
+        {
+            return [];
+        }
+
+        return payload.EnumerateArray().Select(ToDocumentDto).ToList();
+    }
+
+    private async Task ParseDocumentsAsync(string datasetId, IReadOnlyList<string> documentIds)
+    {
+        var payload = new { document_ids = documentIds };
+        var json = JsonSerializer.SerializeToUtf8Bytes(payload, JsonOptions);
+        using var content = new ByteArrayContent(json);
+        content.Headers.ContentType = new MediaTypeHeaderValue("application/json");
+        await SendAsync(HttpMethod.Post, $"/api/v1/datasets/{datasetId}/chunks", content, timeoutSeconds: 300);
+    }
+
+    private async Task<RagFlowDocumentDto> GetDocumentAsync(string datasetId, string documentId)
+    {
+        var data = await SendAsync(HttpMethod.Get, $"/api/v1/datasets/{datasetId}/documents/{documentId}");
+        var payload = GetData(data.RootElement);
+        return ToDocumentDto(payload);
+    }
+
+    private async Task<IReadOnlyList<RagFlowChunkDto>> ListChunksAsync(string datasetId, string documentId)
+    {
+        var parameters = new Dictionary<string, string?>
+        {
+            ["page"] = "1",
+            ["page_size"] = "100"
+        };
+        var data = await SendAsync(
+            HttpMethod.Get,
+            $"/api/v1/datasets/{datasetId}/documents/{documentId}/chunks",
+            parameters: parameters);
+        var payload = GetData(data.RootElement);
+        var rows = payload.ValueKind == JsonValueKind.Object && payload.TryGetProperty("chunks", out var chunks)
+            ? chunks
+            : payload;
+
+        if (rows.ValueKind != JsonValueKind.Array)
+        {
+            return [];
+        }
+
+        return rows.EnumerateArray().Select(ToChunkDto).ToList();
+    }
+
+    private async Task<JsonDocument> SendAsync(
+        HttpMethod method,
+        string path,
+        HttpContent? content = null,
+        IDictionary<string, string?>? parameters = null,
+        bool authorize = true,
+        int timeoutSeconds = 120)
+    {
+        var url = BuildUrl(path, parameters);
+        using var request = new HttpRequestMessage(method, url);
+        if (authorize)
+        {
+            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", ResolveApiKey());
+        }
+
+        if (content is not null)
+        {
+            request.Content = content;
+        }
+
+        using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(timeoutSeconds));
+        using var response = await httpClient.SendAsync(request, cts.Token);
+        var body = await response.Content.ReadAsStringAsync(cts.Token);
+        if (!response.IsSuccessStatusCode)
+        {
+            throw new InvalidOperationException($"RAGFlow HTTP {(int)response.StatusCode}: {body}");
+        }
+
+        var document = JsonDocument.Parse(string.IsNullOrWhiteSpace(body) ? "{}" : body);
+        var root = document.RootElement;
+        if (root.ValueKind == JsonValueKind.Object &&
+            root.TryGetProperty("code", out var code) &&
+            code.ValueKind == JsonValueKind.Number &&
+            code.GetInt32() != 0)
+        {
+            var message = root.TryGetProperty("message", out var msg) ? msg.ToString() : root.ToString();
+            document.Dispose();
+            throw new InvalidOperationException($"RAGFlow API error: {message}");
+        }
+
+        return document;
+    }
+
+    private string BuildUrl(string path, IDictionary<string, string?>? parameters)
+    {
+        var builder = new StringBuilder();
+        builder.Append(BaseUrl);
+        builder.Append(path.StartsWith('/') ? path : $"/{path}");
+        if (parameters is { Count: > 0 })
+        {
+            var query = parameters
+                .Where(x => !string.IsNullOrWhiteSpace(x.Value))
+                .Select(x => $"{Uri.EscapeDataString(x.Key)}={Uri.EscapeDataString(x.Value!)}");
+            var joined = string.Join("&", query);
+            if (!string.IsNullOrWhiteSpace(joined))
+            {
+                builder.Append('?').Append(joined);
+            }
+        }
+
+        return builder.ToString();
+    }
+
+    private string BaseUrl => (ragFlowOptions.BaseUrl ?? "http://127.0.0.1:9380").TrimEnd('/');
+
+    private string ResolveApiKey()
+    {
+        if (!string.IsNullOrWhiteSpace(ragFlowOptions.ApiKey))
+        {
+            return ragFlowOptions.ApiKey.Trim();
+        }
+
+        if (!string.IsNullOrWhiteSpace(ragFlowOptions.ApiKeyFile) && File.Exists(ragFlowOptions.ApiKeyFile))
+        {
+            return File.ReadAllText(ragFlowOptions.ApiKeyFile).Trim();
+        }
+
+        throw new InvalidOperationException("RAGFlow API key is missing. Configure RagFlow:ApiKey or RagFlow:ApiKeyFile.");
+    }
+
+    private static JsonElement GetData(JsonElement root)
+    {
+        return root.ValueKind == JsonValueKind.Object && root.TryGetProperty("data", out var data) ? data : root;
+    }
+
+    private static RagFlowDatasetDto ToDatasetDto(JsonElement item)
+    {
+        return new RagFlowDatasetDto
+        {
+            Id = GetString(item, "id"),
+            Name = GetString(item, "name"),
+            Description = GetString(item, "description"),
+            Permission = GetString(item, "permission"),
+            ChunkMethod = GetString(item, "chunk_method")
+        };
+    }
+
+    private static RagFlowDocumentDto ToDocumentDto(JsonElement item)
+    {
+        return new RagFlowDocumentDto
+        {
+            Id = GetString(item, "id"),
+            Name = GetString(item, "name"),
+            Location = GetString(item, "location"),
+            Run = NormalizeRunStatus(GetString(item, "run")),
+            Progress = GetDecimal(item, "progress"),
+            ChunkCount = GetInt(item, "chunk_count", "chunk_num"),
+            TokenCount = GetInt(item, "token_count", "token_num")
+        };
+    }
+
+    private static RagFlowChunkDto ToChunkDto(JsonElement item)
+    {
+        return new RagFlowChunkDto
+        {
+            Id = GetString(item, "id"),
+            Content = FirstNonEmpty(GetString(item, "content"), GetString(item, "text")),
+            Available = GetBool(item, "available"),
+            Similarity = GetDecimal(item, "similarity", "score"),
+            Keywords = GetStringArray(item, "important_kwd", "important_keywords")
+        };
+    }
+
+    private static string GetString(JsonElement item, string name)
+    {
+        if (item.ValueKind != JsonValueKind.Object || !item.TryGetProperty(name, out var value))
+        {
+            return string.Empty;
+        }
+
+        return value.ValueKind switch
+        {
+            JsonValueKind.String => value.GetString() ?? string.Empty,
+            JsonValueKind.Number => value.ToString(),
+            JsonValueKind.True => "true",
+            JsonValueKind.False => "false",
+            _ => string.Empty
+        };
+    }
+
+    private static int GetInt(JsonElement item, params string[] names)
+    {
+        foreach (var name in names)
+        {
+            if (item.ValueKind == JsonValueKind.Object &&
+                item.TryGetProperty(name, out var value) &&
+                value.TryGetInt32(out var result))
+            {
+                return result;
+            }
+        }
+
+        return 0;
+    }
+
+    private static decimal GetDecimal(JsonElement item, params string[] names)
+    {
+        foreach (var name in names)
+        {
+            if (item.ValueKind == JsonValueKind.Object &&
+                item.TryGetProperty(name, out var value) &&
+                value.TryGetDecimal(out var result))
+            {
+                return result;
+            }
+        }
+
+        return 0;
+    }
+
+    private static bool GetBool(JsonElement item, string name)
+    {
+        if (item.ValueKind != JsonValueKind.Object || !item.TryGetProperty(name, out var value))
+        {
+            return false;
+        }
+
+        return value.ValueKind switch
+        {
+            JsonValueKind.True => true,
+            JsonValueKind.False => false,
+            JsonValueKind.Number => value.TryGetInt32(out var number) && number != 0,
+            JsonValueKind.String => bool.TryParse(value.GetString(), out var parsed) && parsed,
+            _ => false
+        };
+    }
+
+    private static IReadOnlyList<string> GetStringArray(JsonElement item, params string[] names)
+    {
+        foreach (var name in names)
+        {
+            if (item.ValueKind != JsonValueKind.Object || !item.TryGetProperty(name, out var value))
+            {
+                continue;
+            }
+
+            if (value.ValueKind == JsonValueKind.Array)
+            {
+                return value.EnumerateArray()
+                    .Select(x => x.ValueKind == JsonValueKind.String ? x.GetString() ?? string.Empty : x.ToString())
+                    .Where(x => !string.IsNullOrWhiteSpace(x))
+                    .ToList();
+            }
+
+            if (value.ValueKind == JsonValueKind.String)
+            {
+                return value.GetString()?
+                    .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
+                    .ToList() ?? [];
+            }
+        }
+
+        return [];
+    }
+
+    private static string FirstNonEmpty(params string[] values)
+    {
+        return values.FirstOrDefault(x => !string.IsNullOrWhiteSpace(x)) ?? string.Empty;
+    }
+
+    private static string NormalizeRunStatus(string run)
+    {
+        return run switch
+        {
+            "0" => "UNSTART",
+            "1" => "RUNNING",
+            "2" => "CANCEL",
+            "3" => "DONE",
+            "4" => "FAIL",
+            _ => run
+        };
+    }
+
+    private static void ApplyDocumentStatus(ResourceAiMetadata metadata, RagFlowDocumentDto document)
+    {
+        metadata.RagFlowRunStatus = document.Run;
+        metadata.RagFlowChunkCount = document.ChunkCount;
+        metadata.RagFlowTokenCount = document.TokenCount;
+
+        if (document.Run == "DONE")
+        {
+            metadata.ParseStatus = "已解析";
+            metadata.CallableStatus = "可调用";
+            metadata.LastParsedAt = DateTime.UtcNow;
+            return;
+        }
+
+        if (document.Run == "RUNNING")
+        {
+            metadata.ParseStatus = "解析中";
+            metadata.CallableStatus = "不可调用";
+            return;
+        }
+
+        if (document.Run is "FAIL" or "CANCEL")
+        {
+            metadata.ParseStatus = "解析失败";
+            metadata.CallableStatus = "不可调用";
+            return;
+        }
+
+        metadata.ParseStatus = "未解析";
+        metadata.CallableStatus = "不可调用";
+    }
+
+    private string ArchiveTeacherFile(string fullPath, string originalFileName, string datasetName)
+    {
+        if (string.IsNullOrWhiteSpace(ragFlowOptions.TeacherFilesRoot))
+        {
+            return string.Empty;
+        }
+
+        var datasetDir = Path.Combine(ragFlowOptions.TeacherFilesRoot, SafeName(datasetName, "默认资料库"));
+        Directory.CreateDirectory(datasetDir);
+        var target = UniquePath(datasetDir, SafeName(originalFileName, "uploaded-file"));
+        File.Copy(fullPath, target);
+        return target;
+    }
+
+    private static string SafeName(string value, string fallback)
+    {
+        var safe = InvalidPathChars.Replace(value ?? string.Empty, "_").Trim().Trim('.');
+        return string.IsNullOrWhiteSpace(safe) ? fallback : safe[..Math.Min(safe.Length, 120)];
+    }
+
+    private static string UniquePath(string directory, string fileName)
+    {
+        var target = Path.Combine(directory, fileName);
+        if (!File.Exists(target))
+        {
+            return target;
+        }
+
+        var stem = Path.GetFileNameWithoutExtension(fileName);
+        var ext = Path.GetExtension(fileName);
+        var stamp = DateTime.Now.ToString("yyyyMMdd_HHmmss", CultureInfo.InvariantCulture);
+        for (var index = 1; index < 1000; index++)
+        {
+            var candidate = Path.Combine(directory, $"{stem}_{stamp}_{index}{ext}");
+            if (!File.Exists(candidate))
+            {
+                return candidate;
+            }
+        }
+
+        throw new InvalidOperationException($"Could not allocate archive file name for {fileName}");
+    }
+
+    private string GetPhysicalFilePath(ResourceFile file)
+    {
+        var normalized = file.StoragePath.Replace('/', Path.DirectorySeparatorChar);
+        return Path.Combine(environment.ContentRootPath, normalized);
+    }
+
+    private static string BuildDefaultDatasetName(Resource resource, string? requestedName)
+    {
+        if (!string.IsNullOrWhiteSpace(requestedName))
+        {
+            return requestedName.Trim();
+        }
+
+        var grade = resource.Grade?.Name ?? string.Empty;
+        var subject = resource.Subject?.Name ?? string.Empty;
+        var prefix = $"{grade}{subject}".Trim();
+        return string.IsNullOrWhiteSpace(prefix) ? "默认资料库" : $"{prefix}资料库";
+    }
+
+    private static string BuildDatasetDescription(Resource resource)
+    {
+        var subject = resource.Subject?.Name ?? string.Empty;
+        var grade = resource.Grade?.Name ?? string.Empty;
+        return $"由 TeacherResource 自动创建，用于存放{grade}{subject}教学资料、试卷、教案、课件和解析内容。";
+    }
+
+    private static void EnsureAiMetadata(Resource resource)
+    {
+        resource.AiMetadata ??= new ResourceAiMetadata
+        {
+            ResourceId = resource.Id,
+            ParseStatus = "未解析",
+            CallableStatus = "不可调用"
+        };
+    }
+
+    private async Task<string> RecalculatePackCallableStatusAsync(long contextPackId)
+    {
+        var resources = await db.ContextPackResources
+            .Where(x => x.ContextPackId == contextPackId && x.Resource != null && !x.Resource.IsDeleted)
+            .Select(x => x.Resource!)
+            .Include(x => x.AiMetadata)
+            .ToListAsync();
+
+        if (resources.Count == 0)
+        {
+            return "不可调用";
+        }
+
+        return resources.All(x => x.AiMetadata != null && x.AiMetadata.CallableStatus == "可调用")
+            ? "可调用"
+            : "不可调用";
+    }
+
+    private static ResourceAiMetadataDto ToAiMetadataDto(ResourceAiMetadata metadata)
+    {
+        return new ResourceAiMetadataDto
+        {
+            ParseStatus = metadata.ParseStatus,
+            CallableStatus = metadata.CallableStatus,
+            AiSummary = metadata.AiSummary,
+            KeySnippet = metadata.KeySnippet,
+            LastParsedAt = metadata.LastParsedAt,
+            WorkflowUsageCount = metadata.WorkflowUsageCount,
+            RagFlowDatasetId = metadata.RagFlowDatasetId,
+            RagFlowDatasetName = metadata.RagFlowDatasetName,
+            RagFlowDocumentId = metadata.RagFlowDocumentId,
+            RagFlowDocumentName = metadata.RagFlowDocumentName,
+            RagFlowRunStatus = metadata.RagFlowRunStatus,
+            RagFlowChunkCount = metadata.RagFlowChunkCount,
+            RagFlowTokenCount = metadata.RagFlowTokenCount,
+            RagFlowError = metadata.RagFlowError
+        };
+    }
+
+    private IQueryable<Resource> BuildResourceQuery()
+    {
+        return db.Resources
+            .Include(x => x.Subject)
+            .Include(x => x.Grade)
+            .Include(x => x.Files)
+            .Include(x => x.AiMetadata)
+            .Where(x => !x.IsDeleted);
+    }
+
+    private void AddOperationLog(long organizationId, long? resourceId, long operatorId, string action, string description)
+    {
+        db.OperationLogs.Add(new OperationLog
+        {
+            OrganizationId = organizationId,
+            ResourceId = resourceId,
+            OperatorId = operatorId,
+            OperationType = action,
+            OperationContent = description.Length > 1000 ? description[..1000] : description
+        });
+    }
+
+    private static readonly JsonSerializerOptions JsonOptions = new()
+    {
+        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
+    };
+}

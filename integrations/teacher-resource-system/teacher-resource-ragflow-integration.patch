@@ -0,0 +1,67 @@
+using Microsoft.AspNetCore.Mvc;
+using TeacherResource.Api.Common;
+using TeacherResource.Api.DTOs.RagFlow;
+using TeacherResource.Api.DTOs.Resources;
+using TeacherResource.Api.Services;
+
+namespace TeacherResource.Api.Controllers;
+
+[ApiController]
+[Route("api/ragflow")]
+public class RagFlowController(RagFlowService ragFlowService) : ControllerBase
+{
+    [HttpGet("status")]
+    public async Task<ApiResponse<RagFlowStatusDto>> GetStatus()
+    {
+        return await ragFlowService.GetStatusAsync();
+    }
+
+    [HttpGet("datasets")]
+    public async Task<ApiResponse<IReadOnlyList<RagFlowDatasetDto>>> GetDatasets(
+        [FromQuery] string? name,
+        [FromQuery] int pageSize = 30)
+    {
+        return await ragFlowService.ListDatasetsAsync(name, pageSize);
+    }
+
+    [HttpPost("datasets")]
+    public async Task<ApiResponse<RagFlowDatasetDto>> CreateDataset([FromBody] RagFlowCreateDatasetRequest request)
+    {
+        return await ragFlowService.CreateDatasetAsync(request);
+    }
+
+    [HttpPost("resources/{resourceId:long}/files/{fileId:long}/ingest")]
+    public async Task<ApiResponse<RagFlowIngestResultDto>> IngestResourceFile(
+        long resourceId,
+        long fileId,
+        [FromBody] RagFlowIngestResourceFileRequest request)
+    {
+        return await ragFlowService.IngestResourceFileAsync(resourceId, fileId, request);
+    }
+
+    [HttpPost("resources/{resourceId:long}/sync")]
+    public async Task<ApiResponse<ResourceAiMetadataDto>> SyncResource(long resourceId)
+    {
+        return await ragFlowService.SyncResourceAsync(resourceId);
+    }
+
+    [HttpGet("resources/{resourceId:long}/chunks")]
+    public async Task<ApiResponse<IReadOnlyList<RagFlowChunkDto>>> GetResourceChunks(long resourceId)
+    {
+        return await ragFlowService.GetResourceChunksAsync(resourceId);
+    }
+
+    [HttpPost("context-packs/{contextPackId:long}/ingest")]
+    public async Task<ApiResponse<RagFlowContextPackIngestResultDto>> IngestContextPack(
+        long contextPackId,
+        [FromBody] RagFlowIngestContextPackRequest request)
+    {
+        return await ragFlowService.IngestContextPackAsync(contextPackId, request);
+    }
+
+    [HttpPost("retrieve")]
+    public async Task<ApiResponse<RagFlowRetrieveResultDto>> Retrieve([FromBody] RagFlowRetrieveRequest request)
+    {
+        return await ragFlowService.RetrieveAsync(request);
+    }
+}

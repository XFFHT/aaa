+    private async Task<IReadOnlyList<RagFlowDatasetDto>> ListDatasetsInternalAsync(string? name, int pageSize)
+    {
+        var parameters = new Dictionary<string, string?>
+        {
+            ["page"] = "1",
+            ["page_size"] = Math.Clamp(pageSize, 1, 100).ToString(CultureInfo.InvariantCulture)
+        };
+
+        if (!string.IsNullOrWhiteSpace(name))
+        {
+            parameters["name"] = name.Trim();
+        }
+
+        var data = await SendAsync(HttpMethod.Get, "/api/v1/datasets", parameters: parameters);
+        var payload = GetData(data.RootElement);
+        if (payload.ValueKind != JsonValueKind.Array)
+        {
+            return [];
+        }
+
+        return payload.EnumerateArray().Select(ToDatasetDto).ToList();
+    }
+
+    private async Task<RagFlowDatasetDto> EnsureDatasetAsync(string name, string description, string permission, string? chunkMethod)
+    {
+        var existing = await ListDatasetsInternalAsync(name, 100);
+        var matched = existing.FirstOrDefault(x => x.Name == name);
+        if (matched is not null)
+        {
+            return matched;
+        }
+
+        var payload = new
+        {
+            name,
+            description,
+            permission = string.IsNullOrWhiteSpace(permission) ? "me" : permission,
+            chunk_method = string.IsNullOrWhiteSpace(chunkMethod) ? ragFlowOptions.DefaultChunkMethod : chunkMethod
+        };
+
+        var json = JsonSerializer.SerializeToUtf8Bytes(payload, JsonOptions);
+        using var content = new ByteArrayContent(json);
+        content.Headers.ContentType = new MediaTypeHeaderValue("application/json");
+        var data = await SendAsync(HttpMethod.Post, "/api/v1/datasets", content);
+        var created = GetData(data.RootElement);
+        if (created.ValueKind == JsonValueKind.Object)
+        {
+            return ToDatasetDto(created);
+        }
+
+        var afterCreate = await ListDatasetsInternalAsync(name, 100);
+        return afterCreate.First(x => x.Name == name);
+    }
+
+    private async Task<RagFlowDatasetDto> GetDatasetByIdAsync(string datasetId)
+    {
+        var datasets = await ListDatasetsInternalAsync(null, 100);
+        var dataset = datasets.FirstOrDefault(x => x.Id == datasetId);
+        if (dataset is null)
+        {
+            throw new InvalidOperationException($"RAGFlow dataset not found: {datasetId}");
+        }
+
+        return dataset;
+    }
+
+    private async Task<string> ResolveDatasetIdAsync(string? datasetId, string? datasetName)
+    {
+        if (!string.IsNullOrWhiteSpace(datasetId))
+        {
+            return datasetId.Trim();
+        }
+
+        if (string.IsNullOrWhiteSpace(datasetName))
+        {
+            throw new InvalidOperationException("Dataset id or dataset name is required.");
+        }
+
+        var datasets = await ListDatasetsInternalAsync(datasetName, 100);
+        return datasets.FirstOrDefault(x => x.Name == datasetName)?.Id
+            ?? throw new InvalidOperationException($"RAGFlow dataset not found: {datasetName}");
+    }

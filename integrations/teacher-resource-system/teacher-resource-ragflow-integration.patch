+    public async Task<ApiResponse<ResourceAiMetadataDto>> SyncResourceAsync(long resourceId)
+    {
+        var resource = await BuildResourceQuery()
+            .FirstOrDefaultAsync(x => x.Id == resourceId && !x.IsDeleted);
+        if (resource is null)
+        {
+            return ApiResponse<ResourceAiMetadataDto>.Fail("Resource not found.");
+        }
+
+        var metadata = resource.AiMetadata;
+        if (metadata is null || string.IsNullOrWhiteSpace(metadata.RagFlowDatasetId) || string.IsNullOrWhiteSpace(metadata.RagFlowDocumentId))
+        {
+            return ApiResponse<ResourceAiMetadataDto>.Fail("Resource has not been ingested to RAGFlow.");
+        }
+
+        try
+        {
+            var document = await GetDocumentAsync(metadata.RagFlowDatasetId, metadata.RagFlowDocumentId);
+            ApplyDocumentStatus(metadata, document);
+            metadata.RagFlowError = string.Empty;
+            await db.SaveChangesAsync();
+            return ApiResponse<ResourceAiMetadataDto>.Ok(ToAiMetadataDto(metadata));
+        }
+        catch (Exception ex)
+        {
+            metadata.ParseStatus = "解析失败";
+            metadata.CallableStatus = "不可调用";
+            metadata.RagFlowError = ex.Message;
+            await db.SaveChangesAsync();
+            return ApiResponse<ResourceAiMetadataDto>.Fail(ex.Message);
+        }
+    }

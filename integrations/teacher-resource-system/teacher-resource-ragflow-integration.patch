+    private async Task<RagFlowIngestResultDto> IngestFileCoreAsync(
+        Resource resource,
+        ResourceFile file,
+        string? datasetId,
+        string? datasetName,
+        bool parse)
+    {
+        var fullPath = GetPhysicalFilePath(file);
+        if (!File.Exists(fullPath))
+        {
+            throw new FileNotFoundException($"Physical file not found: {fullPath}");
+        }
+
+        var dataset = string.IsNullOrWhiteSpace(datasetId)
+            ? await EnsureDatasetAsync(BuildDefaultDatasetName(resource, datasetName), BuildDatasetDescription(resource), "me", null)
+            : await GetDatasetByIdAsync(datasetId);
+
+        var archivePath = ArchiveTeacherFile(fullPath, file.FileName, dataset.Name);
+        var uploaded = await UploadDocumentAsync(dataset.Id, fullPath, file.FileName, file.MimeType);
+        var document = uploaded.FirstOrDefault();
+        if (document is null || string.IsNullOrWhiteSpace(document.Id))
+        {
+            throw new InvalidOperationException("RAGFlow did not return an uploaded document id.");
+        }
+
+        EnsureAiMetadata(resource);
+        var metadata = resource.AiMetadata!;
+        metadata.RagFlowDatasetId = dataset.Id;
+        metadata.RagFlowDatasetName = dataset.Name;
+        metadata.RagFlowDocumentId = document.Id;
+        metadata.RagFlowDocumentName = string.IsNullOrWhiteSpace(document.Name) ? file.FileName : document.Name;
+        metadata.RagFlowRunStatus = document.Run;
+        metadata.RagFlowError = string.Empty;
+        metadata.AiSummary = string.IsNullOrWhiteSpace(metadata.AiSummary)
+            ? $"已送入 RAGFlow 资料库「{dataset.Name}」，文件名：{file.FileName}。"
+            : metadata.AiSummary;
+
+        if (parse)
+        {
+            metadata.ParseStatus = "解析中";
+            metadata.CallableStatus = "不可调用";
+            await ParseDocumentsAsync(dataset.Id, [document.Id]);
+        }
+        else
+        {
+            ApplyDocumentStatus(metadata, document);
+        }
+
+        return new RagFlowIngestResultDto
+        {
+            ResourceId = resource.Id,
+            FileId = file.Id,
+            DatasetId = dataset.Id,
+            DatasetName = dataset.Name,
+            DocumentId = document.Id,
+            DocumentName = metadata.RagFlowDocumentName,
+            ParseStatus = metadata.ParseStatus,
+            CallableStatus = metadata.CallableStatus,
+            LocalArchivePath = archivePath,
+            Document = document
+        };
+    }

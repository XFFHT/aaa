+    public async Task<ApiResponse<RagFlowRetrieveResultDto>> RetrieveAsync(RagFlowRetrieveRequest request)
+    {
+        if (string.IsNullOrWhiteSpace(request.Question))
+        {
+            return ApiResponse<RagFlowRetrieveResultDto>.Fail("Question is required.");
+        }
+
+        var datasetId = await ResolveDatasetIdAsync(request.DatasetId, request.DatasetName);
+        var payload = new
+        {
+            question = request.Question,
+            dataset_ids = new[] { datasetId },
+            page = 1,
+            page_size = Math.Clamp(request.TopK, 1, 30),
+            top_k = Math.Max(8, request.TopK),
+            similarity_threshold = request.SimilarityThreshold,
+            keyword = request.Keyword
+        };
+
+        var json = JsonSerializer.SerializeToUtf8Bytes(payload, JsonOptions);
+        using var content = new ByteArrayContent(json);
+        content.Headers.ContentType = new MediaTypeHeaderValue("application/json");
+        var result = await SendAsync(HttpMethod.Post, "/api/v1/retrieval", content);
+        return ApiResponse<RagFlowRetrieveResultDto>.Ok(new RagFlowRetrieveResultDto { Raw = result.RootElement.Clone() });
+    }

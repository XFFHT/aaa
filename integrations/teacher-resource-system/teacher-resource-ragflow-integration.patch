+import request from './request'
+
+function unwrapApiResponse(response, fallbackMessage) {
+  if (!response?.success) {
+    throw new Error(response?.message || fallbackMessage)
+  }
+
+  return response.data
+}
+
+export async function getRagFlowStatus() {
+  const response = await request.get('/ragflow/status')
+  return unwrapApiResponse(response, '获取 RAGFlow 状态失败')
+}
+
+export async function getRagFlowDatasets(params) {
+  const response = await request.get('/ragflow/datasets', { params })
+  return unwrapApiResponse(response, '获取 RAGFlow 资料库失败')
+}
+
+export async function ingestResourceFile(resourceId, fileId, payload) {
+  const response = await request.post(`/ragflow/resources/${resourceId}/files/${fileId}/ingest`, payload)
+  return unwrapApiResponse(response, '入库 RAGFlow 失败')
+}
+
+export async function syncResourceRagFlow(resourceId) {
+  const response = await request.post(`/ragflow/resources/${resourceId}/sync`)
+  return unwrapApiResponse(response, '同步 RAGFlow 状态失败')
+}
+
+export async function getResourceRagFlowChunks(resourceId) {
+  const response = await request.get(`/ragflow/resources/${resourceId}/chunks`)
+  return unwrapApiResponse(response, '获取 RAGFlow 切片失败')
+}
+
+export async function ingestContextPack(contextPackId, payload) {
+  const response = await request.post(`/ragflow/context-packs/${contextPackId}/ingest`, payload)
+  return unwrapApiResponse(response, '上下文包入库 RAGFlow 失败')
+}
